{
  "name": "pingo",
  "version": "0.1.0",
  "description": "A macOS-only AI desktop pet for safe project conversations.",
  "main": "./out/main/index.js",
  "author": "Pingo",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css,html}' electron.vite.config.ts eslint.config.js '*.json'",
    "test": "tsx --test tests/*.test.ts",
    "ai:lab": "tsx scripts/ai-lab.ts",
    "pack:mac": "npm run build && electron-builder --mac --arm64"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "electron": "^37.0.0",
    "electron-vite": "^4.0.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.23.8",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.0"
  }
}
